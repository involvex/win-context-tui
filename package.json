{
  "name": "@involvex/win-context-tui",
  "version": "0.1.0",
  "description": "Windows Context Menu Enhancer TUI",
  "type": "module",
  "bin": {
    "win-context-tui": "./src/index.tsx"
  },
  "scripts": {
    "dev": "bun --watch src/index.tsx",
    "start": "bun src/index.tsx",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "build:exe": "bun build --compile --minify ./src/index.tsx --outfile dist/win-context.exe"
  },
  "engines": {
    "bun": ">=1.3.5"
  },
  "license": "MIT",
  "dependencies": {
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.7",
    "react-devtools-core": "^7.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.2.17",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.10.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.52.0"
  }
}
